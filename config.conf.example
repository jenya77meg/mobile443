# Copy to /opt/mobile443/config.conf and fill in your values.
# chmod 600 /opt/mobile443/config.conf

INSTALL_PROFILE="full"
PORTS="443 8443"

ENABLE_TRAF_GUARD="true"
ENABLE_TRAF_GUARD_GOVERNMENT="true"
ENABLE_TRAF_GUARD_ANTISCANNER="true"
ENABLE_MOBILE_ALLOW="true"

ENABLE_TELEGRAM="true"
TG_ENABLED="true"
TG_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TG_ADMIN_ID="YOUR_TELEGRAM_ADMIN_CHAT_ID"

XRAY_ACCESS_LOG="/var/log/remnanode/access.log"

REMNAWAVE_API_URL="https://panel.example.com"
REMNAWAVE_API_TOKEN="YOUR_REMNAWAVE_API_TOKEN"
TG_ID_SOURCE="telegramId"

TRAF_GUARD_BASE_URL="https://raw.githubusercontent.com/shadow-netlab/traffic-guard-lists/refs/heads/main/public"
GOV_LIST_URL="${TRAF_GUARD_BASE_URL}/government_networks.list"
ANTISCANNER_LIST_URL="${TRAF_GUARD_BASE_URL}/antiscanner.list"

TG_CUSTOM_MESSAGE='⚠️ <b>Notice</b>\nConnection from <code>{ip}</code> was temporarily limited because the LTE endpoint is used over non-mobile internet.\n\nPlease use a server without the LTE tag, or switch to mobile data.'
TG_USERNAME_SEPARATOR=''

# Skip Telegram / deferred block until a single non-mobile connection exceeds this many bytes (0 = disabled).
MOBILE443_MIN_NOTIFY_BYTES="10485760"

# Seconds before adding IP to deferred block set after notification (monitor script).
DEFERRED_BLOCK_DELAY="30"
